# BELM Portal - local/deployment environment example
APP_ENV=development
PORTAL_URL=http://localhost:10000
ALLOWED_ORIGINS=http://localhost:10000

# PostgreSQL - use DATABASE_URL OR the DB_* variables below
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=belm_portal
DB_USER=postgres
DB_PASS=
DB_SSLMODE=prefer

# REQUIRED in production. Use a long random secret.
JWT_SECRET=replace-with-a-long-random-secret

# SMTP (optional until email delivery is enabled)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=BELM General Tech
SMTP_SECURE=tls
