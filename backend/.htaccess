# Route every request (except real files) through index.php, so URLs like
# /customers, /billing/invoices, /auth/login all reach the router.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /api/
  RewriteRule ^(?:config|scripts)(?:/|$) - [F,L,NC]
  RewriteRule ^(?:schema|repair_admin)\.sql$ - [F,L,NC]

  # BELM WM internal workshop endpoint. This endpoint was added after the
  # front-controller route table and must resolve before the generic router.
  # Keeps /api/belm-workshop-home?section=petty-cash stable for the frontend.
  RewriteRule ^belm-workshop-home/?$ api/belm_workshop_home.php [L,QSA,NC]

  # Workshop Manager Service & Maintenance reporting + BELM Workshop Petty Cash.
  # Provides customer/permanent-status report filters, PDF/CSV exports, expense
  # receipt uploads and the dedicated petty-cash transaction workflow.
  RewriteRule ^workshop-service-maintenance/?$ api/workshop_service_maintenance.php [L,QSA,NC]

  # Main Admin Dashboard Machine & Stock Alerts. This aggregates the live
  # machine service state, spare inventory, Operator + Procurement fuel records
  # and Proforma quote-validity expiry into one synchronized alert endpoint.
  RewriteRule ^admin-dashboard-alerts/?$ api/admin_dashboard_alerts.php [L,QSA,NC]

  # Main Admin Dashboard rotating fleet messages. Shows every registered
  # machine in rotation and inserts service reminders/overdue notices with
  # higher priority when a service_due_alert exists for the machine.
  RewriteRule ^admin-machine-messages/?$ api/admin_machine_messages.php [L,QSA,NC]

  # Bank Controller VAT summary. VAT is recognized only from actual invoice
  # payments and is treated as money payable to TRA, not BELM income.
  RewriteRule ^bank-vat-summary/?$ api/bank_vat_summary.php [L,QSA,NC]

  # Atomic Proforma -> Invoice flow. The handler can optionally record a
  # customer payment in the same database transaction, keeping invoice status
  # and payment history synchronized without requiring an official receipt.
  RewriteRule ^proforma-generate-invoice/?$ proforma-generate-invoice.php [L,QSA,NC]

  # Shared Job Card detail modal API used by Technician and Workshop Manager.
  RewriteRule ^job-card-detail/?$ job-card-detail.php [L,QSA,NC]

  # Customer Check Up is a customer-authenticated checklist workflow with its
  # own GET/POST handler. Keep it explicit so it cannot fall through to the
  # generic front controller and become a read-only checklist preview.
  RewriteRule ^customer-checkup/?$ api/customer_checkup.php [L,QSA,NC]

  RewriteRule ^index\.php$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L]
</IfModule>

Options -Indexes
