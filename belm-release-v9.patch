+// "Engineer" was the original name of the BELM Workshop Manager role. Treat
+// it as a display/assignment alias so old accounts keep working without
+// creating a second visible role throughout menus, reports and user forms.
+function canonical_belm_role_name(string $name): string {
+    $name = trim($name);
+    return strcasecmp($name, 'Engineer') === 0 ? 'Workshop Manager' : $name;
+}
+
+function canonical_belm_role_names(array $names): array {
+    $result = [];
+    $seen = [];
+    foreach ($names as $name) {
+        $canonical = canonical_belm_role_name((string)$name);
+        if ($canonical === '') continue;
+        $key = mb_strtolower($canonical);
+        if (isset($seen[$key])) continue;
+        $seen[$key] = true;
+        $result[] = $canonical;
+    }
+    return $result;
+}
+
 // Returns display names for every role assigned to a BELM staff account.
 // Keep the primary role first because it controls the default landing page;
 // additional roles extend the workspaces and analysis available after login.
@@ -669,7 +691,45 @@ function role_names_for_user(string $userId, string $primaryRoleName): array {
          ORDER BY r.name'
     );
     $stmt->execute([$userId]);
-    return array_values(array_unique(array_merge([$primaryRoleName], $stmt->fetchAll(PDO::FETCH_COLUMN))));
+    return canonical_belm_role_names(array_merge([$primaryRoleName], $stmt->fetchAll(PDO::FETCH_COLUMN)));
+}
+
+// Reject duplicate machine identities before an INSERT/UPDATE. Serial and
+// registration numbers identify a machine globally; a fleet number only needs
+// to be unique inside its customer company. This complements the database's
+// serial-number constraint and also gives the user a clear 409 response.
+function assert_machine_identity_available(
+    ?string $serialNumber,
+    ?string $regNumber,
+    ?string $fleetNumber,
+    string $customerId,
+    ?string $excludeMachineId = null
+): void {
+    $checks = [
+        ['column' => 'serial_number', 'value' => $serialNumber, 'scopeCustomer' => false, 'message' => 'This serial number is already registered to another machine.'],
+        ['column' => 'reg_number', 'value' => $regNumber, 'scopeCustomer' => false, 'message' => 'This registration number is already registered to another machine.'],
+        ['column' => 'fleet_number', 'value' => $fleetNumber, 'scopeCustomer' => true, 'message' => 'This fleet number is already used by another machine for this customer.'],
+    ];
+
+    foreach ($checks as $check) {
+        $value = trim((string)($check['value'] ?? ''));
+        if ($value === '') continue;
+        // Include Recycle Bin rows: restoring an older machine must never
+        // recreate the same serial/registration/fleet identity.
+        $sql = 'SELECT 1 FROM machines WHERE LOWER(TRIM(' . $check['column'] . ')) = LOWER(TRIM(?))';
+        $params = [$value];
+        if ($check['scopeCustomer']) {
+            $sql .= ' AND customer_id = ?';
+            $params[] = $customerId;
+        }
+        if ($excludeMachineId !== null && $excludeMachineId !== '') {
+            $sql .= ' AND id <> ?';
+            $params[] = $excludeMachineId;
+        }
+        $stmt = db()->prepare($sql . ' LIMIT 1');
+        $stmt->execute($params);
+        if ($stmt->fetchColumn()) json_error($check['message'], 409);
+    }
 }
 
