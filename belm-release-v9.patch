+}
+
+.belm-sidebar-theme-toggle,
+.belm-sidebar-logout {
+  min-height: 42px;
+  color: #d4deea;
+  border-color: rgba(151, 174, 196, .20);
+  border-radius: 9px;
+  background: transparent;
+  font-size: 11px;
+}
+
+@media (max-width: 980px) {
+  .belm-admin-sidebar {
+    width: min(86vw, 380px);
