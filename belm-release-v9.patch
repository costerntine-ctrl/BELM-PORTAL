+    || group.find(role => String(role.name || "").trim().toLowerCase() === "workshop manager")
+    || group[0]
+  );
+}
+
+function uniqueRoleLabels(names) {
+  const seen = new Set();
+  return names.map(displayRoleName).filter(name => {
+    const key = name.trim().toLowerCase();
+    if (!key || seen.has(key)) return false;
+    seen.add(key);
+    return true;
+  });
+}
 
