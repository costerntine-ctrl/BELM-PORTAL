+
+/* V681 - unified sidebar design for every BELM role workspace. */
+.dashboard-sidebar {
+  isolation: isolate;
+  width: 304px;
+  color: #d5dfeb;
+  border-right: 1px solid rgba(56, 91, 122, .46);
+  background:
+    linear-gradient(rgba(255,255,255,.018) 1px, transparent 1px),
+    radial-gradient(circle at 92% 4%, rgba(16, 190, 109, .13), transparent 17rem),
+    linear-gradient(180deg, #081c30 0%, #061828 56%, #041321 100%);
+  background-size: 28px 28px, auto, auto;
+  box-shadow: 18px 0 42px rgba(3, 15, 26, .22);
+}
+
+.dashboard-sidebar::before {
+  position: absolute;
+  inset: 0 0 auto;
+  z-index: 2;
+  height: 5px;
+  content: "";
+  background: linear-gradient(90deg, var(--blue) 0 29%, var(--green) 29% 57%, var(--yellow) 57% 82%, #090d13 82% 100%);
+}
+
+.sidebar-brand {
+  min-height: 96px;
+  padding: 20px 18px 17px;
+  border-bottom-color: rgba(151, 174, 196, .14);
+}
+
+.sidebar-logo {
+  width: 46px;
+  height: 46px;
+  flex-basis: 46px;
+  border: 1px solid rgba(245, 200, 35, .75);
+  border-radius: 14px;
+}
+
+.sidebar-brand strong { font-size: 20px; }
+.sidebar-brand small { color: #8ea1b6; font-size: 10px; }
+
+.signed-user {
+  margin: 14px 14px 9px;
+  padding: 12px;
+  border-color: rgba(143, 169, 194, .18);
+  border-radius: 14px;
+  background: rgba(255,255,255,.035);
+}
+
+.signed-avatar {
+  color: #fff;
+  border: 1px solid rgba(22, 120, 237, .48);
+  background: rgba(22, 120, 237, .18);
+}
+
+.sidebar-heading {
+  padding: 11px 16px 6px;
+  color: #72869b;
+  font-size: 10px;
+}
+
+.role-navigation { padding: 5px 10px 18px; }
+
+.role-nav {
+  grid-template-columns: 24px 34px minmax(0, 1fr) 13px;
+  gap: 9px;
+  min-height: 55px;
+  margin: 1px 0;
+  padding: 8px 10px;
+  color: #9eafc1;
+  border: 0;
+  border-radius: 0;
+  background: transparent;
+  font-weight: 650;
+}
+
+.role-nav-index {
+  color: #627589;
+  font-size: 10px;
+  font-variant-numeric: tabular-nums;
+  font-weight: 600;
+  letter-spacing: .04em;
+  text-align: center;
+}
+
+.role-nav-icon,
+.role-nav-icon.green,
+.role-nav-icon.yellow,
+.role-nav-icon.cyan,
+.role-nav-icon.purple {
+  width: 32px;
+  height: 32px;
+  color: #86b9f1;
+  border: 1px solid rgba(56, 131, 204, .26);
+  border-radius: 9px;
+  background: rgba(25, 91, 153, .10);
+  font-size: 9px;
+}
+
+.role-nav b { color: inherit; font-size: 13px; font-weight: 700; }
+.role-nav small { color: #778ba0; font-size: 10px; }
+.role-nav i { color: #607b92; font-size: 19px; }
+
+.role-nav:hover {
+  color: #f4f8fc;
+  background: rgba(255,255,255,.035);
+  transform: none;
+}
+
+.role-nav.active {
+  color: #fff;
+  border-color: transparent;
+  background: #0d2237;
+}
+
+.role-nav.active::before {
+  inset: 0 auto 0 -10px;
+  width: 3px;
+  border-radius: 0 3px 3px 0;
+  background: var(--yellow);
+  box-shadow: 0 0 12px rgba(245, 200, 35, .28);
+}
+
+.role-nav.active .role-nav-index { color: #c2cedb; }
+.role-nav.active .role-nav-icon { color: #fff; background: rgba(22, 120, 237, .20); }
+.role-nav.active i { color: var(--yellow); }
+
+.portal-switcher {
+  margin: 0 13px 9px;
+  border-color: rgba(143, 169, 194, .17);
+  border-radius: 10px;
+  background: rgba(1, 8, 15, .20);
+}
+
+.sidebar-actions {
+  grid-template-columns: 1fr;
+  gap: 8px;
+  padding: 11px 13px calc(13px + env(safe-area-inset-bottom));
+  border-top-color: rgba(151, 174, 196, .14);
+  background: rgba(1, 8, 15, .34);
+}
+
+.sidebar-actions button {
+  min-height: 42px;
+  color: #d4deea;
+  border-color: rgba(151, 174, 196, .20);
+  border-radius: 9px;
+  background: transparent;
+}
+
+.dashboard-main { margin-left: 304px; }
+
+@media (max-width: 900px) {
+  .dashboard-sidebar {
+    width: min(86vw, 380px);
+    max-width: calc(100vw - 48px);
+  }
+
+  .mobile-menu-button {
+    width: 48px;
+    height: 48px;
+    border: 1px solid var(--yellow);
+    border-radius: 12px;
+    background: #071b2e;
+  }
+
+  .dashboard-main { margin-left: 0; }
+}
