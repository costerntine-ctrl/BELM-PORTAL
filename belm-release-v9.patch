+  const updateThemeLabel = () => {
+    theme.textContent = document.documentElement.dataset.theme === "dark" ? "☀ Light mode" : "☾ Dark mode";
+  };
+  updateThemeLabel();
+  theme.addEventListener("click", async () => {
+    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
+    if (window.BELMTheme?.set) await window.BELMTheme.set(next);
+    else document.documentElement.dataset.theme = next;
+    updateThemeLabel();
+  });
+  window.addEventListener("belm-theme-change", updateThemeLabel);
+  const logout = document.createElement("button");
+  logout.type = "button";
+  logout.textContent = "Log out securely";
+  logout.addEventListener("click", () => {
+    if (isBelmView) {
+      ["belm_admin_token", "belm_admin_user", "belm_active_account_type"].forEach((key) => localStorage.removeItem(key));
+    } else {
+      ["belm_customer_token", "belm_active_account_type", "belm_session_refreshed_belm_customer_token"].forEach((key) => localStorage.removeItem(key));
+    }
+    location.replace("/login");
+  });
+  footer.append(home, theme, logout);
+
+  sidebar.prepend(heading);
+  sidebar.prepend(identity);
+  sidebar.prepend(brand);
+  sidebar.append(footer);
+  sidebar.id = "cwmUnifiedSidebar";
+  sidebar.setAttribute("aria-label", "Customer Workshop role menu");
+
+  const menuButton = document.createElement("button");
+  menuButton.id = "cwmUnifiedMenuButton";
+  menuButton.className = "cwm-unified-menu-button";
+  menuButton.type = "button";
+  menuButton.textContent = "☰";
+  menuButton.setAttribute("aria-label", "Open Customer Workshop menu");
+  menuButton.setAttribute("aria-controls", "cwmUnifiedSidebar");
+  menuButton.setAttribute("aria-expanded", "false");
+  const scrim = document.createElement("button");
+  scrim.className = "cwm-unified-menu-scrim";
+  scrim.type = "button";
+  scrim.setAttribute("aria-label", "Close Customer Workshop menu");
+  scrim.hidden = true;
+  document.body.prepend(scrim);
+  document.body.prepend(menuButton);
+
+  const closeMenu = () => {
+    document.body.classList.remove("cwm-unified-menu-open");
+    menuButton.setAttribute("aria-expanded", "false");
+    menuButton.textContent = "☰";
+    scrim.hidden = true;
+  };
+  const openMenu = () => {
+    document.body.classList.add("cwm-unified-menu-open");
+    menuButton.setAttribute("aria-expanded", "true");
+    menuButton.textContent = "×";
+    scrim.hidden = false;
+  };
+  menuButton.addEventListener("click", () => document.body.classList.contains("cwm-unified-menu-open") ? closeMenu() : openMenu());
+  scrim.addEventListener("click", closeMenu);
+  document.addEventListener("keydown", (event) => { if (event.key === "Escape") closeMenu(); });
+
+  function ensureIcon(link) {
+    let icon = link.querySelector(".cwm-action-icon");
+    if (!icon) {
+      icon = document.createElement("i");
+      icon.className = "cwm-action-icon";
+      link.prepend(icon);
+    }
+    const href = String(link.getAttribute("href") || "");
+    const code = link === machinesLink ? "CM"
+      : href.includes("breakdown-workflow") ? "JC"
+      : href.includes("customer-store") ? "SP"
+      : href.includes("procurement") ? "PR"
+      : href.includes("technician") || href.includes("customer-users") ? "TC"
+      : href.includes("workshop-analysis") ? "WA"
+      : href.includes("general-report") ? "GR"
+      : href.includes("petty-cash") ? "PC"
+      : href.includes("general-analysis") ? "GA"
+      : href.includes("settings") ? "SE"
+      : href.includes("sales-documents") ? "IP" : "MN";
+    if (icon.textContent !== code) icon.textContent = code;
+  }
+
+  function synchronizeNavigation() {
+    const links = [...navigation.querySelectorAll(":scope > a")];
+    const seen = new Set();
+    links.forEach((link) => {
+      const label = String(link.textContent || "").replace(/\s+/g, " ").trim().toLowerCase();
+      const href = new URL(link.getAttribute("href") || "#", location.href).href;
+      const key = `${label}|${href}`;
+      link.classList.toggle("cwm-menu-duplicate", seen.has(key));
+      seen.add(key);
+    });
+    const visible = links.filter((link) => !link.hidden
+      && !link.classList.contains("cwm-role-hidden")
+      && !link.classList.contains("cwm-menu-duplicate"));
+    visible.forEach((link, index) => {
+      ensureIcon(link);
+      let number = link.querySelector(".cwm-nav-index");
+      if (!number) {
+        number = document.createElement("span");
+        number.className = "cwm-nav-index";
+        number.setAttribute("aria-hidden", "true");
+        link.prepend(number);
+      }
+      const sequence = String(index + 1).padStart(2, "0");
+      if (number.textContent !== sequence) number.textContent = sequence;
+      if (!link.dataset.cwmMenuWired) {
+        link.dataset.cwmMenuWired = "1";
+        link.addEventListener("click", closeMenu);
+      }
+    });
+    const count = document.getElementById("cwmSidebarCount");
+    if (count.textContent !== String(visible.length)) count.textContent = String(visible.length);
+  }
+
+  function synchronizeIdentity() {
+    const title = String(document.getElementById("workshopTitle")?.textContent || "Customer Workshop");
+    const company = title.split("—")[0].trim() || "Customer Workshop";
+    const companyNode = document.getElementById("cwmSidebarCompany");
+    const roleNode = document.getElementById("cwmSidebarRole");
+    const companyLabel = company.toUpperCase();
+    const roleLabel = document.getElementById("cwmRoleLabel")?.textContent || "Assigned role";
+    if (companyNode.textContent !== companyLabel) companyNode.textContent = companyLabel;
+    if (roleNode.textContent !== roleLabel) roleNode.textContent = roleLabel;
+  }
+
+  const observer = new MutationObserver(() => {
+    synchronizeNavigation();
+    synchronizeIdentity();
+  });
+  observer.observe(sidebar, { childList: true, subtree: true, characterData: true, attributes: true, attributeFilter: ["class", "hidden"] });
+  synchronizeNavigation();
+  synchronizeIdentity();
+  document.body.classList.add("cwm-unified-sidebar-ready");
+  window.addEventListener("resize", () => { if (innerWidth > 900) closeMenu(); });
+  window.addEventListener("pagehide", () => observer.disconnect(), { once: true });
+})();
