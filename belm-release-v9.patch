+    max-width: calc(100vw - 48px);
+  }
+
+  .belm-sidebar-toggle {
+    width: 48px;
+    height: 48px;
+    border: 1px solid var(--belm-sidebar-yellow);
+    border-radius: 12px;
+    background: #071b2e;
+  }
+}
