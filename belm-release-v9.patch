+  background: rgba(3, 15, 27, .30);
+}
+
+.belm-sidebar-nav {
+  padding: 9px 10px 18px;
+}
+
+.belm-sidebar-link {
+  display: grid;
+  grid-template-columns: 24px 34px minmax(0, 1fr) auto;
+  gap: 9px;
+  min-height: 50px;
