+}
+
+.belm-sidebar-link:not(.belm-sidebar-back-link) > span:nth-child(2) {
+  min-width: 0;
+  overflow: visible;
+  white-space: normal;
+}
+
+.belm-sidebar-icon {
+  width: 32px;
+  height: 32px;
+  flex-basis: 32px;
+  color: #86b9f1;
+  border: 1px solid rgba(56, 131, 204, .26);
+  border-radius: 9px;
+  background: rgba(25, 91, 153, .10);
+  font-size: 8px;
+}
+
+.belm-sidebar-link:hover {
+  color: #f4f8fc;
+  border-color: transparent;
+  background: rgba(255,255,255,.035);
+  transform: none;
+}
+
+.belm-sidebar-link.active {
+  color: #fff;
+  border-color: transparent;
+  background: #0d2237;
+  box-shadow: none;
+}
+
+.belm-sidebar-link.active::before {
+  inset: 0 auto 0 -10px;
+  width: 3px;
+  border-radius: 0 3px 3px 0;
+  background: var(--belm-sidebar-yellow);
+  box-shadow: 0 0 12px rgba(255, 212, 0, .28);
+}
+
+.belm-sidebar-link.active .belm-sidebar-index { color: #c2cedb; }
+.belm-sidebar-link.active .belm-sidebar-icon {
+  color: #fff;
+  border-color: rgba(255,255,255,.18);
+  background: rgba(30, 120, 202, .20);
+  box-shadow: none;
+}
+
+.belm-sidebar-back-link {
+  grid-template-columns: 34px minmax(0, 1fr);
+  margin: 0 0 10px;
+  padding-bottom: 13px;
+  border-bottom: 1px solid rgba(151, 174, 196, .13);
+}
+
+.belm-sidebar-footer {
+  padding: 11px 13px calc(13px + env(safe-area-inset-bottom));
